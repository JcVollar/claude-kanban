{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "~/bin/kanban-hook.sh", "async": true }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [{ "type": "command", "command": "~/bin/kanban-hook.sh", "async": true }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "~/bin/kanban-hook.sh", "async": true }] }
    ]
  }
}
